{
  "expo": {
    "name": "MesCourses+",
    "slug": "mescourses",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.mannydevfr.mescourses",
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-localization",
      "expo-font",
      "./plugins/withAndroidToolchain.cjs",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#1B3B5F",
          "image": "./assets/splash-mark.png",
          "imageWidth": 128,
          "resizeMode": "contain"
        }
      ]
    ],
    "scheme": "mescourses"
  }
}
